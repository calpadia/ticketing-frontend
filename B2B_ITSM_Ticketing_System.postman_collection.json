    {
      "name": "My Quota API (USER)",
      "description": "Endpoint untuk USER mengakses kuota client-nya sendiri. ClientId diambil otomatis dari data user yang sedang login (JWT token), sehingga USER hanya bisa melihat kuota miliknya sendiri. Bisa diakses oleh role ADMIN dan USER.",
      "item": [
        {
          "name": "Get My Quotas",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/my-quotas",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "my-quotas"]
            },
            "description": "Mengambil semua kuota (PM & CM) untuk client milik user yang sedang login. Mengembalikan daftar kuota per tahun. Jika user tidak terkait dengan client (misalnya ADMIN tanpa client), mengembalikan array kosong."
          }
        },
        {
          "name": "Get My Quota by Year",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/my-quotas/year/2026",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "my-quotas", "year", "2026"]
            },
            "description": "Mengambil kuota (PM & CM) untuk client milik user yang sedang login, untuk tahun tertentu. Mengembalikan detail kuota termasuk pmQuota, cmQuota, pmUsed, cmUsed."
          }
        }
      ]
    },
    {
      "name": "Ticket API",
      "item": [
        {
          "name": "Create Ticket (with Attachment)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "title", "value": "Server tidak bisa diakses", "type": "text"},
                {"key": "description", "value": "Server produksi down sejak pukul 10:00 WIB", "type": "text"},
                {"key": "priority", "value": "L1", "type": "text"},
                {"key": "maintenanceType", "value": "CM", "type": "text"},
                {"key": "clientId", "value": "1", "type": "text"},
                {"key": "requesterId", "value": "1", "type": "text"},
                {"key": "files", "type": "file", "src": [], "description": "(Optional) Pilih file lampiran pendukung. Bisa multiple file."}
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets"]
            },
            "description": "Buat ticket baru dengan lampiran file (optional). Gunakan form-data. Field 'files' bisa dikosongkan jika tidak ada lampiran."
          }
        },
        {
          "name": "Create Ticket (JSON - tanpa Attachment)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Server tidak bisa diakses\",\n  \"description\": \"Server produksi down sejak pukul 10:00 WIB\",\n  \"priority\": \"L1\",\n  \"maintenanceType\": \"CM\",\n  \"clientId\": 1,\n  \"requesterId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets"]
            },
            "description": "Buat ticket baru tanpa lampiran menggunakan JSON body. Backward compatible dengan API lama."
          }
        },
        {
          "name": "Get All Tickets",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets"]
            }
          }
        },
        {
          "name": "Get Ticket by ID",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "1"]
            }
          }
        },
        {
          "name": "Get Ticket by Number",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/number/TKT-20260522-001",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "number", "TKT-20260522-001"]
            }
          }
        },
        {
          "name": "Update Ticket Status",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"changedBy\": 1,\n  \"notes\": \"Mulai dikerjakan oleh tim teknis\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/1/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "1", "status"]
            },
            "description": "Update status ticket. Transisi yang valid:\n- OPEN → IN_PROGRESS\n- IN_PROGRESS → RESOLVED / CLOSED\n- RESOLVED → CLOSED / IN_PROGRESS (reopen)\n- CLOSED → (tidak bisa diubah)\n\nSetiap perubahan status otomatis dicatat di progress log."
          }
        },
        {
          "name": "Get Ticket Progress Log",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tickets/1/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tickets", "1", "progress"]
            },
            "description": "Mengambil riwayat perubahan status ticket (progress log). Diurutkan berdasarkan waktu perubahan (ascending)."
          }
        },
        {
          "name": "Export Tickets to CSV",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
