            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"password\": \"newPassword456\",\n  \"role\": \"AGENT\"\n}"
            },
            "url": {
